{
  "name": "next-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:cloudflare": "NODE_ENV=production opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && npm run db:migrate:local && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply justevery --local",
    "db:migrate:remote": "wrangler d1 migrations apply justevery --remote",
    "suggestions": "node scripts/suggestions.mjs",
    "tokens:measure": "node scripts/token-count/measure.mjs",
    "tokens:publish": "node scripts/token-count/publish.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@opennextjs/cloudflare": "1.20.4",
    "autoprefixer": "^10.4.21",
    "lucide-react": "^0.511.0",
    "next": "15.5.24",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "^9.26.0",
    "eslint-config-next": "15.5.24",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "postcss": "8.5.24",
    "phin": "^3.7.1",
    "jimp": "^1.6.0",
    "esbuild": "0.28.1",
    "undici": "7.29.1",
    "ws": "8.21.0",
    "@node-minify/core": "8.0.5",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.7",
    "@humanfs/node": "0.16.8",
    "qs": "6.16.0",
    "js-yaml": "4.3.2"
  }
}
